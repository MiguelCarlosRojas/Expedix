# ==============================================================================
# EXPEDIX BACKEND - VARIABLES DE ENTORNO (DESARROLLO LOCAL / PRODUCCION)
# ==============================================================================

# Entorno Django
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me-for-production-use-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000
TIME_ZONE=America/Lima

# CORS y CSRF (para permitir comunicacion con Frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Base de datos (Por defecto usa SQLite si USE_POSTGRES=False)
USE_POSTGRES=False
# Si se desea usar PostgreSQL local o en Docker:
# USE_POSTGRES=True
# DATABASE_URL=postgresql://expedientes_user:expedientes_secret_2026@localhost:5432/expedientes_db
# O mediante variables individuales:
DB_NAME=expedientes_db
DB_USER=expedientes_user
DB_PASSWORD=expedientes_secret_2026
DB_HOST=localhost
DB_PORT=5432

# Redis y Celery (Por defecto InMemory si USE_REDIS=False)
USE_REDIS=False
# Si se inicia Redis local o en Docker (puerto 6379):
# USE_REDIS=True
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Integracion Google Workspace (Opcional en desarrollo)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=root

# Web Push (VAPID opcional para notificaciones push en navegador)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@expedientescorp.com
